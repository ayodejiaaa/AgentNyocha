# Copy to .env next to docker-compose.aws.yml and fill in. .env is never committed.

# Hostnames (no https://). Both must have DNS pointing at the server.
API_HOST=api.example.com
WEB_HOST=review.example.com

AWS_REGION=eu-west-1
S3_BUCKET=change-me-bucket-name

# The RDS address. Use a password of letters and digits only (it sits inside a URL);
# add ?sslmode=require so the connection to RDS is encrypted.
DATABASE_URL=postgresql+psycopg2://akowe:CHANGE_ME@your-db.xxxx.eu-west-1.rds.amazonaws.com:5432/extraction_review?sslmode=require

# Signs login sessions. Generate with:  openssl rand -hex 32
JWT_SECRET=
