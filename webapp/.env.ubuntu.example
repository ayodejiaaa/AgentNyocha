# Example environment configuration for Ubuntu Server deployment
# with PostgreSQL installed directly on the host server.
#
# Copy this file to .env:
#   cp .env.ubuntu.example .env
#   chmod 600 .env
#
# IMPORTANT: .env contains secrets and passwords. Never commit it to git.

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL on the host Ubuntu server)
# -----------------------------------------------------------------------------
# The containers reach the host PostgreSQL via 'host.docker.internal' (enabled in docker-compose).
# Password should contain letters and digits only (it goes inside a URL).
POSTGRES_USER=akowe
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=extraction_review
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@host.docker.internal:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Signs login session JWT tokens. Must be a random string of at least 32 characters.
# Generate on Ubuntu with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-char-secret-openssl-rand-hex-32

# Token expiry in hours (default 12):
JWT_EXPIRE_HOURS=12

# -----------------------------------------------------------------------------
# 3. URLS & CORS CONFIGURATION
# -----------------------------------------------------------------------------
# The exact address(es) of the review screen that reviewers will open in their browser.
# Cannot be wildcard (*). Comma-separate if multiple.
# E.g.: http://198.51.100.2:3000  OR  https://review.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# The API URL that the review screen (Next.js) will call from the user's browser.
# Passed as a build arg into the Next.js bundle:
# E.g.: http://198.51.100.2:8000  OR  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Options: 'local' (stores on Ubuntu server disk inside Docker named volume)
#          's3'    (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_BACKEND=local

# S3 configuration (required ONLY if STORAGE_BACKEND=s3):
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# 5. PORTS & DOMAINS (OPTIONAL)
# -----------------------------------------------------------------------------
# Host ports to bind services to:
API_PORT=8000
WEB_PORT=3000

# If using Caddy with the 'tls' profile (docker compose -f docker-compose.ubuntu.yml --profile tls up -d):
API_HOST=api.yourdomain.com
WEB_HOST=review.yourdomain.com

# -----------------------------------------------------------------------------
# 6. OCR & EXTRACTION TUNING (OPTIONAL)
# -----------------------------------------------------------------------------
# Extraction OCR zoom (PyMuPDF zoom factor, 2.0 = 144 DPI):
EXTRACTION_ZOOM=2.0
# Resolution of full-page exported images:
PAGE_IMAGE_ZOOM=2.0
# Worker polling interval (seconds):
WORKER_POLL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=30
STALE_JOB_SECONDS=600
MAX_JOB_ATTEMPTS=3
