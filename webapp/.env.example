POSTGRES_PASSWORD=change-me-to-something-long-and-random
JWT_SECRET=change-me-to-something-long-and-random-and-different-from-above

# Leave these blank (or unset) to use local-disk storage on the box, fine
# for getting started. Fill in once you're moving to S3 - see README.md.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
