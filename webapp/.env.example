# For docker-compose.yml (everything on one box). For AWS see .env.aws.example.
# Copy to .env and fill in. .env is never committed.

# Letters and digits only - it goes inside a URL.
POSTGRES_PASSWORD=change-me
# Signs login sessions. Generate with:  openssl rand -hex 32
JWT_SECRET=
# The review screen's exact address, e.g. https://review.example.com (comma-separated for several).
CORS_ALLOW_ORIGINS=

# local = files on this box's disk (fine for a trial). s3 = a bucket (use this for real).
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
